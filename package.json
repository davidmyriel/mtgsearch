{
  "name": "mtgsearch-web",
  "private": true,
  "description": "Scryfall-compatible card search with plain-English search, on TopK. TypeScript serves search; a Python job builds the index.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node app/dev-server.ts",
    "test": "node --test \"app/test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "golden": "node app/golden.ts",
    "conformance": "node app/conformance.ts",
    "eval": "node app/relevance.ts",
    "search": "node app/search-cli.ts"
  },
  "dependencies": {
    "topk-js": "^0.16.1"
  },
  "devDependencies": {
    "@netlify/functions": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
